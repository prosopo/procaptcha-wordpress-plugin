#. Plugin Name of the plugin
#: prosopo-procaptcha.php src/Widget/Procaptcha_Widget.php:77
msgid "Prosopo Procaptcha"
msgstr "Prosopo Procaptcha"

#. Description of the plugin
#: prosopo-procaptcha.php
msgid "Free, GDPR-compliant CAPTCHA that stops spam bots on WordPress core forms and 21 form plugins, page builders and themes. No cookies."
msgstr "CAPTCHA gratuito e conforme al GDPR che ferma i bot di spam sui moduli principali di WordPress e su 21 plugin di moduli, page builder e temi. Senza cookie."

